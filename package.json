{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.cjs",
    "build": "pnpm run typecheck && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/nativos-precificacao run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "test": "tsx --test lib/pricing-engine/src/*.test.ts artifacts/api-server/src/**/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env lib/db/src/migrate.ts",
    "start": "node --env-file-if-exists=.env artifacts/api-server/dist/index.mjs",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "tsx": "catalog:",
    "@playwright/test": "^1.58.2"
  }
}
