# Copie para .env na raiz do projeto.
# Local: PostgreSQL embarcado, persistente em disco, sem servidor externo.
DATABASE_MODE=local
LOCAL_DATABASE_PATH=.data/postgres
# Para PostgreSQL externo, use DATABASE_MODE=postgres e preencha DATABASE_URL.
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/nativos
API_PORT=5000
WEB_PORT=5173
HOST=127.0.0.1
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
